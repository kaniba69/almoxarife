# GEMINI_API_KEY / API_KEY: Chave da API protegida no backend (nunca exposta ao frontend)
# Utilizada para diagnósticos preditivos e auditoria inteligente de estoque.
GEMINI_API_KEY=""
API_KEY=""

# SPREADSHEET_ID: Identificador da planilha oficial no Google Sheets
# Exemplo: 1v9ORiDO9Fy0xkiXx6vxxV4UZ5rcS2bXRdz3ButABpTI
SPREADSHEET_ID=""

# SHEET_GID: Identificador numérico da aba da planilha (padrão: 1585513030)
SHEET_GID="1585513030"

# GOOGLE OAUTH / SERVICE ACCOUNT CREDENTIALS (para sincronização direta pelo backend):
# Opção A: OAuth Web Client
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Opção B: Conta de Serviço (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SERVICE_ACCOUNT_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

